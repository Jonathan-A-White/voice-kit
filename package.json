{
  "name": "voice-kit",
  "version": "0.1.0",
  "description": "Speaking and listening in the browser, for React PWAs: @voice-kit/composer (a hold-to-talk message composer, a React component), @voice-kit/speech (a read-aloud engine with Pause, Resume, Restart and Stop that keep the place, and a themeable SpeakingBar), @voice-kit/talks (multi-turn conversations: a talk of turns, the turn loop over an injected grind, picture turns, a store, a Dexie store and a searchable list), @voice-kit/forms (a form as the tutor sees it, and the command that sends it) and @voice-kit/testing (honest speech, microphone and talk fakes for an app's tests, vitest and Playwright).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jonathan-A-White/voice-kit.git"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "exports": {
    "./composer": {
      "types": "./packages/composer/dist/index.d.ts",
      "default": "./packages/composer/dist/index.js"
    },
    "./composer/styles.css": "./packages/composer/dist/styles.css",
    "./speech": {
      "types": "./packages/speech/dist/index.d.ts",
      "default": "./packages/speech/dist/index.js"
    },
    "./speech/react": {
      "types": "./packages/speech/dist/react.d.ts",
      "default": "./packages/speech/dist/react.js"
    },
    "./speech/styles.css": "./packages/speech/dist/styles.css",
    "./talks": {
      "types": "./packages/talks/dist/index.d.ts",
      "default": "./packages/talks/dist/index.js"
    },
    "./talks/dexie": {
      "types": "./packages/talks/dist/dexieStore.d.ts",
      "default": "./packages/talks/dist/dexieStore.js"
    },
    "./talks/react": {
      "types": "./packages/talks/dist/TalkList.d.ts",
      "default": "./packages/talks/dist/TalkList.js"
    },
    "./talks/grind": {
      "types": "./packages/talks/dist/grind.d.ts",
      "default": "./packages/talks/dist/grind.js"
    },
    "./talks/styles.css": "./packages/talks/dist/styles.css",
    "./forms": {
      "types": "./packages/forms/dist/index.d.ts",
      "default": "./packages/forms/dist/index.js"
    },
    "./testing/speech": {
      "types": "./packages/testing/dist/speech.d.ts",
      "default": "./packages/testing/dist/speech.js"
    },
    "./testing/mic": {
      "types": "./packages/testing/dist/mic.d.ts",
      "default": "./packages/testing/dist/mic.js"
    },
    "./testing/talks": {
      "types": "./packages/testing/dist/talks.d.ts",
      "default": "./packages/testing/dist/talks.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "packages/*/dist/**",
    "packages/*/grind/**",
    "packages/*/package.json",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b packages/composer/tsconfig.build.json packages/speech/tsconfig.build.json packages/talks/tsconfig.build.json packages/forms/tsconfig.build.json packages/testing/tsconfig.build.json && node -e \"for (const p of ['composer', 'speech', 'talks']) require('node:fs').copyFileSync('packages/' + p + '/src/styles.css', 'packages/' + p + '/dist/styles.css')\"",
    "prepare": "npm run build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/composer/tsconfig.json --noEmit && tsc -p packages/speech/tsconfig.json --noEmit && tsc -p packages/talks/tsconfig.json --noEmit && tsc -p packages/forms/tsconfig.json --noEmit && tsc -p examples/composer-demo/tsconfig.json --noEmit",
    "test": "npm run check:personal && vitest run",
    "check:personal": "node scripts/check-personal.mjs",
    "smoke": "node scripts/consumer-smoke.mjs",
    "demo": "npm run dev --workspace composer-demo"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "dexie": ">=4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "dexie": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dexie": "^4.4.6",
    "eslint": "^9.39.1",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^28.1.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.18"
  }
}
